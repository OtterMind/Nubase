{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nubase.ai/schemas/goai/function-manifest.schema.json",
  "title": "GOAI Nubase Function Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "entrypoint", "verifyJwt", "privileged"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "entrypoint": {
      "const": "index.js"
    },
    "verifyJwt": {
      "const": true
    },
    "privileged": {
      "const": false
    }
  }
}
