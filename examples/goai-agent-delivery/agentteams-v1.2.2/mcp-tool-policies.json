{
  "schemaVersion": "1.0.0",
  "agentTeamsVersion": "v1.2.2",
  "enforcement": [
    "Higress MCP server allowTools",
    "Higress consumer authorization"
  ],
  "optionalDefenseInDepth": {
    "component": "Nubase TypeScript stdio MCP bridge",
    "controls": [
      "NUBASE_ALLOWED_TOOLS",
      "NUBASE_DENIED_TOOLS"
